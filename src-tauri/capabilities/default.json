{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "http:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    { "identifier": "fs:create-app-specific-dirs", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-rename", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-copy-file", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }] }
  ]
}
